{
    "name": "elgentos/magento2-varnish-extended",
    "description": "This extension extends the built-in Varnish functionalities",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "require": {
        "magento/framework": ">=103.0.7",
        "magento/module-page-cache": "*",
        "php": "^8.3"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Elgentos\\VarnishExtended\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
