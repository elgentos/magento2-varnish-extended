varnishtest "Testing the grace period to trigger graced hits & misses"

barrier b1 cond 2
barrier b2 cond 2

server s1 {
    # Probe request
    rxreq
    expect req.url == "/health_check.php"
    txresp

    close
    barrier b1 sync
    accept

    # Initial request always hits the backend
    rxreq
    expect req.url == "/"
    txresp  -hdr "Cache-Control: public, max-age=2"

    # Third request triggers a graced hit, which causes a background fetch
    rxreq
    expect req.url == "/"
    txresp  -hdr "Cache-Control: public, max-age=2"

    # Release the client only once the refreshed object is in place, so its wait
    # towards grace expiry does not race the background fetch.
    barrier b2 sync

    # Fourth request triggers a cache miss
    rxreq
    expect req.url == "/"
    txresp  -hdr "Cache-Control: public, max-age=2"
} -start

# Generate VCL
shell {
    export s1_addr="${s1_addr}"
    export s1_port="${s1_port}"
    export GRACE_PERIOD=2
    ${testdir}/helpers/parse_vcl.pl "${testdir}/../../etc/varnish6.vcl" "${tmpdir}/output.vcl"
}

# timeout_idle defaults to 5s, which would close the client connection during the wait
# for grace to expire below, so req4 would never get a response.
varnish v1 -arg "-f" -arg "${tmpdir}/output.vcl" -arg "-p" -arg "vsl_mask=+Hash" \
    -arg "-p" -arg "timeout_idle=30" -start

# Wait for probe
barrier b1 sync

# The object is fresh for 2s and servable stale for another 2s, so every request
# below lands a full second inside the window it tests. With a 1s ttl and 1s grace
# each request arrived exactly on a boundary, which made this test flaky under load.
client c1 {
    # Initial request
    txreq -url "/" -req "GET" -hdr "Context: req1"
    rxresp
    expect resp.http.X-Magento-Cache-Debug == "MISS"

    # Second request hits the cache
    txreq -url "/" -req "GET" -hdr "Context: req2"
    rxresp
    expect resp.http.X-Magento-Cache-Debug == "HIT"

    # Past the ttl, well inside the grace period
    delay 3

    # Third request triggers a graced hit
    txreq -url "/" -req "GET" -hdr "Context: req3"
    rxresp
    expect resp.http.X-Magento-Cache-Debug == "HIT-GRACE"

    # Wait for the refreshed object to land, then let its ttl and grace both expire
    barrier b2 sync
    delay 5

    # Fourth request triggers a cache miss
    txreq -url "/" -req "GET" -hdr "Context: req4"
    rxresp
    expect resp.http.X-Magento-Cache-Debug == "MISS"
} -run
