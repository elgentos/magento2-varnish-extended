varnishtest "Marketing parameters with special characters in the value (e.g. Google _gl linker) are fully stripped"

barrier b1 cond 2

server s1 {
    # Probe request
    rxreq
    expect req.url == "/health_check.php"
    txresp

    # the probe expects the connection to close
    close
    barrier b1 sync
    accept

    # Only the initial request should reach the backend
    rxreq
    expect req.url == "/product"
    txresp -body "Product page response"
} -start

# Generate the VCL file
shell {
    export s1_addr="${s1_addr}"
    export s1_port="${s1_port}"
    export TRACKING_PARAMETERS="_gl|gclid|utm_source"
    ${testdir}/helpers/parse_vcl.pl "${testdir}/../../etc/varnish6.vcl" "${tmpdir}/output.vcl"
}

varnish v1 -arg "-f" -arg "${tmpdir}/output.vcl" -start

# make sure the probe request fired
barrier b1 sync

client c1 {
    txreq -method "GET" -url "/product"
    rxresp
    expect resp.http.X-Magento-Cache-Debug == "MISS"

    # Google cross-domain linker values contain '*' and '.'
    txreq -method "GET" -url "/product?_gl=1*1abc2d*_up*MQ..*_ga*MTIzNDU2.*_ga_XXXXXXX*czE3"
    rxresp
    expect resp.http.X-Magento-Cache-Debug == "HIT"

    txreq -method "GET" -url "/product?_gl=1*other*_ga*value"
    rxresp
    expect resp.http.X-Magento-Cache-Debug == "HIT"

    # Other tracking values may contain special characters as well
    txreq -method "GET" -url "/product?gclid=abc*def!ghi~jkl"
    rxresp
    expect resp.http.X-Magento-Cache-Debug == "HIT"

    txreq -method "GET" -url "/product?utm_source=x&_gl=1*abc*_ga*def"
    rxresp
    expect resp.http.X-Magento-Cache-Debug == "HIT"
} -run
