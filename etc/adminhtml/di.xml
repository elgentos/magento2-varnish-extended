<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="varnish" xsi:type="string">Elgentos\VarnishExtended\Model\Notifications</item>
                <item name="varnish_purge_stats" xsi:type="string">Elgentos\VarnishExtended\Model\PurgeStatistics\Notification</item>
            </argument>
        </arguments>
    </type>
    <type name="Elgentos\VarnishExtended\Model\Notifications">
        <arguments>
            <argument name="notifications" xsi:type="array">
                <item name="marketing-params"
                      xsi:type="object">Elgentos\VarnishExtended\Model\MarketingParameters\Notification</item>
            </argument>
        </arguments>
    </type>
</config>
